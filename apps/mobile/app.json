{
  "expo": {
    "name": "Space Conquistador",
    "slug": "space-conquistador",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "spaceconquistador",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spaceconquistador.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121829"
      },
      "package": "com.spaceconquistador.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#121829",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#121829"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}