{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "export PATH=/opt/homebrew/opt/node@22/bin:$PATH && cd apps/mobile && npx expo start --web --port 8081"
      ],
      "port": 8081
    },
    {
      "name": "server",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "export PATH=/opt/homebrew/opt/node@22/bin:$PATH && npm run server"
      ],
      "port": 3001
    }
  ]
}